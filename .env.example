# ── Safe for the browser (NEXT_PUBLIC_*) — still set in Vercel, never commit real values ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SERVER ONLY — never prefix with NEXT_PUBLIC_, never expose to the client ──
SUPABASE_SERVICE_ROLE_KEY=
# Secret admin entry path, e.g. a long random slug. Not an authentication mechanism, only an extra obscurity layer.
ADMIN_PANEL_PATH=
# HMAC secret used to sign the internal admin gate header (generate: openssl rand -hex 32)
ADMIN_GATE_SECRET=
# Salt for hashing visitor IPs in the contact-form rate limiter (generate: openssl rand -hex 24)
CONTACT_HASH_SALT=
SENTRY_DSN=

# Google OAuth is configured in the Supabase dashboard (Auth → Providers → Google), not in app env vars.
# Use separate Supabase projects (and separate values) for Production vs Preview/Development.
